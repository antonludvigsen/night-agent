{
  "name": "night-agent-backend",
  "version": "0.1.0",
  "description": "Webhooks, dashboard API and worker for Night Agent",
  "main": "app.js",
  "private": true,
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "worker": "node ../worker/worker.js",
    "db:init": "node data/init.js",
    "keys": "node scripts/generate-keys.js",
    "jwt-keys": "mkdir -p ../keys && test ! -f ../keys/jwt-private.pem && openssl genrsa -out ../keys/jwt-private.pem 2048 && openssl rsa -in ../keys/jwt-private.pem -pubout -out ../keys/jwt-public.pem && chmod 600 ../keys/jwt-private.pem && echo 'JWT keys created in keys/' || echo 'keys/jwt-private.pem already exists, left unchanged'",
    "user:create": "node scripts/create-user.js",
    "cdn:upload": "node scripts/upload-to-cdn.js",
    "test": "node --test \"../tests/unit/*.test.js\"",
    "security:db-snapshot": "node ../tests/security/db-snapshot.js",
    "security:webhook-test": "node ../tests/security/webhook-test.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nodemailer": "^10.5.0",
    "response-time": "^2.3.4",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "twilio": "^6.3.0"
  }
}
