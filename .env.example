# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://night-agent.me

# Twilio (Twilio Console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+4593709060
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI (Claude Console)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Security (generate locally)
SESSION_SECRET=
DATA_ENCRYPTION_KEY=

# Mail (as in Exercise 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
STAFF_ALERT_EMAIL=

# Database
DB_PATH=./backend/data/night-agent.db
