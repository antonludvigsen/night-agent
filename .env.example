# Copy to .env and fill in. Never commit .env.

# Server
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=https://night-agent.me

# Twilio (Twilio Console)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+4593709060
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# AI (Claude Console)
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Security (generate locally)
LOOKUP_SALT=
DATA_ENCRYPTION_KEY=

# Login tokens (RSA key pair, generate with: npm run jwt-keys). Files stay outside git.
JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt-public.pem

# Optional, local development only: self-signed certificate (Exercise 10, task 4 and 5)
HTTPS_KEY_PATH=
HTTPS_CERT_PATH=

# Mail (as in Exercise 4: a Gmail account with an App Password, never the real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
STAFF_ALERT_EMAIL=

# Database
DB_PATH=./backend/data/night-agent.db
